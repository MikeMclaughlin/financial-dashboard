{
  "rewrites": [
    { "source": "/api/health", "destination": "/data/health.json" },
    { "source": "/health.json", "destination": "/data/health.json" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
